# Kopyahin ito bilang .env (copy .env.example .env) at palitan kung kailangan.
# Default ng XAMPP: user "root", walang password, port 3306.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/adviserlink_db

# Local development defaults. For production, follow DEPLOYMENT_GUIDE.md.
APP_ENV=development
RUN_SCHEMA_MIGRATIONS=true
UPLOAD_DIR=

# Maglagay ng mahaba at random na text (16+ na character). Kung iiwan itong default o blangko,
# gagawa ang app ng sarili at ise-save sa backend/.jwt_secret.
JWT_SECRET=palitan-ito-ng-mahabang-random-na-text
JWT_HOURS=8

# Mga address ng web app na pinapayagang kumausap sa API (paghiwalayin ng comma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5001,http://127.0.0.1:5001
# For a phone on the LAN, also add http://<IP-ng-PC>:5001 before starting the API.

# Opsyonal: kung lalagyan, ang email na may ganitong domain lang ang makakapag-register. Hal: isu.edu.ph
# ALLOWED_EMAIL_DOMAIN=isu.edu.ph

# Frontend base URL (for email links). Use your deployed HTTPS URL in production.
APP_BASE_URL=http://localhost:5173

# Email verification and password reset use one-time links sent by SMTP.
# For Gmail, enable 2-Step Verification and create an App Password at:
# https://myaccount.google.com/apppasswords
# Never use your regular Gmail password or commit the App Password.
#
# To enable real email verification locally, set SKIP_EMAIL_VERIFICATION=false
# after filling all SMTP settings below. Keep it true only for local demo accounts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set SMTP_USER and SMTP_FROM to the Gmail address sending the messages.
SMTP_USER=
# Set this to the 16-character Gmail App Password (not your Gmail login password).
SMTP_PASS=
SMTP_FROM=

# Full database dumps; keep this directory outside the web root and access-controlled.
ADVISERLINK_BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
